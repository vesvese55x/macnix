#!/usr/bin/env bash
# ============================================================================
#  MacNix 2.0 — macnix-gpu-mode
# ============================================================================
#  GPU'yu host sürücüsü ile vfio-pci arasında geçirir.
#
#  macnix-gpu-mode vm     → GPU'yu vfio-pci'ye bağla (VM için)
#  macnix-gpu-mode host   → GPU'yu host sürücüsüne geri ver (Linux için)
#  macnix-gpu-mode status → hangi sürücüde?
#
#  Tek GPU (muxless) laptop senaryosunda macOS açıkken Linux tarafı
#  görüntü veremez; bu yüzden vm moduna geçerken lightdm durdurulur.
#  Geri dönüş her zaman host modudur.
# ============================================================================
set -Eeuo pipefail

ETC="${MACNIX_ETC:-/etc/macnix}"
VARS="${MACNIX_VAR:-/var/lib/macnix}"
PLAN="$ETC/install-plan.json"

C_OK=$'\033[0;32m'; C_WA=$'\033[1;33m'; C_ER=$'\033[0;31m'; C_B=$'\033[1m'; C_R=$'\033[0m'
say()  { printf '%s[macnix]%s %s\n' "$C_B" "$C_R" "$*"; }
ok()   { printf '%s  [ ok ]%s %s\n' "$C_OK" "$C_R" "$*"; }
warn() { printf '%s [warn]%s %s\n' "$C_WA" "$C_R" "$*"; }
die()  { printf '%s [fail]%s %s\n' "$C_ER" "$C_R" "$*" >&2; exit 1; }

[[ $EUID -eq 0 ]] || die "root gerekli"

# ── Hangi PCI adresleri? ─────────────────────────────────────────────────────
mapfile -t PCIS < <(python3 - "$PLAN" <<'PY' 2>/dev/null || true
import json, sys, os
try:
    plan = json.load(open(sys.argv[1]))
except Exception:
    sys.exit(0)
for pci in plan.get("passthrough_gpus") or []:
    print(pci)
    # aynı IOMMU grubundaki HDMI sesini de ekle
    link = f"/sys/bus/pci/devices/{pci}/iommu_group"
    if os.path.islink(link):
        grp = os.path.basename(os.readlink(link))
        d = f"/sys/kernel/iommu_groups/{grp}/devices"
        if os.path.isdir(d):
            for dev in os.listdir(d):
                try:
                    cls = open(f"/sys/bus/pci/devices/{dev}/class").read().strip()
                except OSError:
                    continue
                if cls == "0x040300" and dev != pci:
                    print(dev)
PY
)

if (( ${#PCIS[@]} == 0 )); then
  # plan yok: vfio.conf'tan kimlik oku
  if [[ -f /etc/modprobe.d/macnix-vfio.conf ]]; then
    ids=$(grep -oP 'ids=\K.*' /etc/modprobe.d/macnix-vfio.conf | head -1)
    say "kimlik listesi: ${ids:-yok}"
  fi
  die "Passthrough GPU tanımlı değil ($PLAN). macnix-doctor ile kontrol edin."
fi

driver_of() {
  local pci="$1"
  local link="/sys/bus/pci/devices/${pci}/driver"
  [[ -L "$link" ]] && basename "$(readlink -f "$link")" || echo "none"
}

do_status() {
  printf '%-16s %-14s %-10s %s\n' "PCI" "SÜRÜCÜ" "IOMMU GRUBU" "CİHAZ"
  for pci in "${PCIS[@]}"; do
    grp=$(basename "$(readlink -f "/sys/bus/pci/devices/${pci}/iommu_group" 2>/dev/null)" 2>/dev/null || echo "-")
    desc=$(lspci -s "$pci" 2>/dev/null | cut -d' ' -f2- || echo "?")
    printf '%-16s %-14s %-10s %s\n' "$pci" "$(driver_of "$pci")" "$grp" "$desc"
  done
}

unbind_all() {
  local pci="$1" drv
  drv=$(driver_of "$pci")
  if [[ "$drv" != "none" ]]; then
    echo "$pci" > "/sys/bus/pci/devices/${pci}/driver/unbind" 2>/dev/null || true
    say "  ${pci} ← ${drv} ayrıldı"
  fi
  echo "vfio-pci" > "/sys/bus/pci/devices/${pci}/driver_override" 2>/dev/null || true
  modprobe vfio-pci 2>/dev/null || true
  echo "$pci" > /sys/bus/pci/drivers/vfio-pci/bind 2>/dev/null || \
    warn "  ${pci} vfio-pci'ye bağlanamadı (yeniden başlatma sonrası kalıcı çözüm /etc/modprobe.d'da)"
}

bind_host() {
  local pci="$1"
  echo "" > "/sys/bus/pci/devices/${pci}/driver_override" 2>/dev/null || true
  if [[ "$(driver_of "$pci")" == "vfio-pci" ]]; then
    echo "$pci" > "/sys/bus/pci/drivers/vfio-pci/unbind" 2>/dev/null || true
  fi
  echo 1 > "/sys/bus/pci/devices/${pci}/remove" 2>/dev/null || true
  sleep 0.3
  echo 1 > /sys/bus/pci/rescan 2>/dev/null || true
  sleep 0.5
  say "  ${pci} → $(driver_of "$pci")"
}

case "${1:-status}" in
  status) do_status ;;
  vm)
    say "GPU'lar VM'e devrediliyor"
    for pci in "${PCIS[@]}"; do unbind_all "$pci"; done
    ok "vfio-pci aktif"
    ;;
  host)
    say "GPU'lar host'a geri veriliyor"
    for pci in "${PCIS[@]}"; do bind_host "$pci"; done
    systemctl start lightdm.service 2>/dev/null || true
    ok "host sürücüsü geri yüklendi"
    ;;
  *) die "Kullanım: macnix-gpu-mode {vm|host|status}" ;;
esac
