#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
MacNix 2.0 — macnix-setup (grafik kurulum sihirbazı)
====================================================
İlk açılışta otomatik açılır. Üç görevi var:

  1. Durumu göstermek ("ne eksik?")
  2. Tek tuşla macOS kurulum hazırlığını yürütmek
  3. Yönlendirmek (kurulum bittiğinde "macOS'u başlat")

Ağır işi macnix-install-macos yapar; bu arayüz onu çağırıp ilerlemeyi gösterir.
Root gerektiren komutlar sudoers kuralıyla şifresiz çalışır
(/etc/sudoers.d/99-macnix — 10-installer'dan SONRA okunur).

Kullanım:
    macnix-setup --gui       (varsayılan)
    macnix-setup --cli       (TTY'de metin modu)
"""

import json
import os
import re
import subprocess
import sys
import threading

VARS = os.environ.get("MACNIX_VAR", "/var/lib/macnix")
SUDO = ["sudo", "-n"]

STEPS = [
    ("Önyükleme bileşenleri", 1),
    ("UEFI firmware", 2),
    ("macOS imajı indirme", 3),
    ("Disk imajı dönüştürme", 4),
    ("macOS diski", 5),
    ("OpenCore yapılandırması", 6),
    ("Kurulumu başlatma", 7),
]


# ── Durum ────────────────────────────────────────────────────────────────────
def state() -> dict:
    out = {}
    for key, path in (
        ("assets", f"{VARS}/assets/opencore/OC/OpenCore.efi"),
        ("opencore", f"{VARS}/firmware/OpenCore/OpenCore.qcow2"),
        ("ovmf", f"{VARS}/firmware/OVMF_CODE.fd"),
        ("basesystem", f"{VARS}/disks/BaseSystem.img"),
        ("disk", f"{VARS}/disks/macOS.qcow2"),
    ):
        out[key] = os.path.exists(path)
    try:
        with open(f"{VARS}/state.json") as fh:
            out["state"] = json.load(fh).get("state", "new")
    except (OSError, json.JSONDecodeError):
        out["state"] = "new"
    return out


def plan() -> dict:
    for path in ("/etc/macnix/install-plan.json",):
        try:
            with open(path) as fh:
                return json.load(fh)
        except (OSError, json.JSONDecodeError):
            continue
    return {}


def run_step(step_no, on_line, on_done):
    """macnix-install-macos --step N --json çalıştır, olayları ilet."""
    cmd = SUDO + ["macnix-install-macos", "--step", str(step_no), "--json"]
    try:
        proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                                text=True, bufsize=1)
    except FileNotFoundError:
        on_line(f"HATA: macnix-install-macos bulunamadı")
        on_done(step_no, False)
        return
    for line in proc.stdout:
        line = line.rstrip("\n")
        try:
            ev = json.loads(line)
        except json.JSONDecodeError:
            if line.strip():
                on_line(line)
            continue
        if ev.get("event") in ("log", "ok", "warn", "error"):
            on_line(ev.get("msg", ""))
        elif ev.get("event") == "progress":
            on_line(f"{ev.get('value', 0)}% — {ev.get('msg', '')}")
    proc.wait()
    on_done(step_no, proc.returncode == 0)


# ── CLI (fallback) ──────────────────────────────────────────────────────────
def cli():
    print("\033[1mMacNix 2.0 — kurulum hazırlığı\033[0m")
    st = state()
    print(f"Durum: {st['state']}")
    for name, no in STEPS:
        cmd = SUDO + ["macnix-install-macos", "--step", str(no)]
        print(f"\n\033[1;36m▶ {no}. {name}\033[0m")
        rc = subprocess.call(cmd)
        if rc != 0:
            print(f"\033[0;31mAdım {no} başarısız (kod {rc})\033[0m")
            print("Yeniden denemek için: sudo macnix-install-macos --step", no)
            return rc
    print("\n\033[0;32mHazırlık tamamlandı.\033[0m Kurulum ekranı açılıyor…")
    return subprocess.call(SUDO + ["macnix-vm", "install"])


# ── GUI ─────────────────────────────────────────────────────────────────────
def gui():
    try:
        import gi
        gi.require_version("Gtk", "3.0")
        from gi.repository import Gtk, Gdk, GLib, Pango
    except (ImportError, ValueError):
        print("GTK bulunamadı — metin moduna geçiliyor", file=sys.stderr)
        return cli()

    p = plan()
    st = state()

    _apply_theme(Gtk, Gdk)

    # ── Pencere sürükleme yardımcıları ──────────────────────────────────────
    def _start_drag(widget, event):
        """Başlık alanına basılıp sürüklenince pencereyi taşır."""
        if event.button != 1:
            return False
        win.begin_move_drag(event.button, int(event.x_root), int(event.y_root),
                            event.time)
        return True

    def _on_key(_w, ev):
        """Klavye kısayolları: Ctrl+Q kapat, Ctrl+T terminal, Esc terminali kapat."""
        ctrl = ev.state & Gdk.ModifierType.CONTROL_MASK
        if ctrl and ev.keyval in (Gdk.KEY_q, Gdk.KEY_Q):
            Gtk.main_quit()
            return True
        if ctrl and ev.keyval in (Gdk.KEY_t, Gdk.KEY_T):
            toggle_terminal()
            return True
        return False


    # ── Ana pencere ──────────────────────────────────────────────────────────
    # DİKKAT (2026-11-15): Eski pencere Openbox'ta çerçevesiz/başlıksız açılıyor
    # ve EKRANA SABİTLENİYORDU — kullanıcı taşıyamıyor, kapatamıyordu.
    # Artık: gerçek başlık çubuğu (kapat/küçült), sürüklenebilir başlık alanı,
    # boyutlandırma tutamacı ve Home/End gibi kısayollar.
    win = Gtk.Window(title="MacNix 2.0")
    win.set_default_size(900, 660)
    # Ekran 768 px ise pencereyi küçült — başlık çubuğu ve düğmeler görünür kalsın
    try:
        scr = Gdk.Screen.get_default()
        if scr is not None and scr.get_height() < 760:
            win.set_default_size(880, max(520, scr.get_height() - 60))
    except Exception:                                  # noqa: BLE001
        pass
    win.set_position(Gtk.WindowPosition.CENTER)
    win.set_resizable(True)
    win.set_decorated(True)
    win.set_border_width(0)
    win.connect("destroy", Gtk.main_quit)
    win.connect("key-press-event", _on_key)

    outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
    win.add(outer)

    # Başlık
    head = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
    head.set_border_width(18)
    head.set_name("head")
    title = Gtk.Label()
    title.set_markup("<span size='x-large' weight='bold'>MacNix 2.0</span>")
    title.set_xalign(0)
    sub = Gtk.Label()
    mode = p.get("arch", "virtio")
    subtitle = ("GPU passthrough modu" if mode == "vfio"
                else "Yazılım render modu — GPU hızlandırma yok")
    sub.set_markup(f"<span size='small' foreground='#666'>{subtitle} · "
                   f"{p.get('macos_name', 'macOS')}</span>")
    sub.set_xalign(0)
    head.pack_start(title, False, False, 0)
    head.pack_start(sub, False, False, 0)

    # Sürükle-bırak: başlık alanından tutup pencere taşınabilir
    for w in (head, title, sub):
        w.add_events(Gdk.EventMask.BUTTON_PRESS_MASK)
        w.connect("button-press-event", _start_drag)
    outer.pack_start(head, False, False, 0)

    # Bilgi kutusu
    info_txt = Gtk.Label()
    warn_list = p.get("warnings") or []
    warn_html = ""
    if warn_list:
        warn_html = "\n".join(f"• {w}" for w in warn_list[:4])
    info_txt.set_markup(
        f"<span size='small'>VM: {p.get('vm_cores', 2)} çekirdek / "
        f"{int(p.get('vm_ram_mb', 4096)) // 1024} GB RAM\n"
        f"{warn_html}</span>")
    info_txt.set_xalign(0)
    info_txt.set_line_wrap(True)
    info_txt.set_margin_start(18)
    info_txt.set_margin_end(18)
    outer.pack_start(info_txt, False, False, 8)

    # Adım listesi
    listbox = Gtk.ListBox()
    listbox.set_selection_mode(Gtk.SelectionMode.NONE)
    rows = {}
    for name, no in STEPS:
        row = Gtk.ListBoxRow()
        hb = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        hb.set_border_width(6)
        icon = Gtk.Label(label="○")
        label = Gtk.Label()
        label.set_markup(f"<span size='medium'>{no}. {name}</span>")
        label.set_xalign(0)
        hb.pack_start(icon, False, False, 6)
        hb.pack_start(label, True, True, 0)
        row.add(hb)
        listbox.add(row)
        rows[no] = (icon, label)
    outer.pack_start(listbox, False, False, 0)

    # İlerleme + günlük
    prog = Gtk.ProgressBar()
    prog.set_margin_start(18)
    prog.set_margin_end(18)
    prog.set_margin_top(10)
    outer.pack_start(prog, False, False, 0)

    scroll = Gtk.ScrolledWindow()
    scroll.set_policy(Gtk.PolicyType.AUTOMATIC, Gtk.PolicyType.AUTOMATIC)
    scroll.set_margin_start(18)
    scroll.set_margin_end(18)
    scroll.set_margin_top(6)
    logview = Gtk.TextView()
    logview.set_editable(False)
    logview.set_monospace(True)
    logview.set_wrap_mode(Gtk.WrapMode.WORD_CHAR)
    logview.set_size_request(-1, 90)
    logbuf = logview.get_buffer()
    scroll.add(logview)
    # ── Modern terminal paneli ───────────────────────────────────────────────
    # TASARIM (2026-11-15 kullanıcı isteği): "terminal modern olsun ve
    # hareket ettirilebilir / kapanabilir / tekrar açılabilir olsun; sabit
    # durup kullanımı engelliyor."
    # Çözüm: panelin ALTINDA, kendi başlık çubuğu olan bir Gtk.Paned bölmesi.
    #  • Başlık çubuğundan sürüklenebilir (kendi içinde taşınır)
    #  • ✕ ile kapanır, "Konsol" düğmesi ya da Ctrl+T ile geri açılır
    #  • Üstteki çizgi (Gtk.Paned) ile yüksekliği ayarlanır
    #  • Renkli, modern görünüm (koyu tema + monospace + imleç)
    term_holder = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
    term_holder.set_no_show_all(True)

    term_head = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
    term_head.set_border_width(6)
    term_head.set_name("termhead")
    term_dots = Gtk.Label(label="● ● ●")
    term_dots.set_name("termdots")
    term_title = Gtk.Label()
    term_title.set_markup("<span size='small' weight='bold'>MacNix Terminal</span>")
    term_title.set_xalign(0)
    term_hint = Gtk.Label()
    term_hint.set_markup("<span size='x-small' alpha='60%'>sürükle · Ctrl+T kapat/aç</span>")
    term_hint.set_xalign(1)
    btn_term_hide = Gtk.Button(label="✕")
    btn_term_hide.set_relief(Gtk.ReliefStyle.NONE)
    btn_term_hide.set_tooltip_text("Terminali kapat (Ctrl+T)")
    term_head.pack_start(term_dots, False, False, 0)
    term_head.pack_start(term_title, False, False, 4)
    term_head.pack_end(btn_term_hide, False, False, 0)
    term_head.pack_end(term_hint, False, False, 0)
    term_holder.pack_start(term_head, False, False, 0)

    term_scroll = Gtk.ScrolledWindow()
    term_scroll.set_policy(Gtk.PolicyType.AUTOMATIC, Gtk.PolicyType.AUTOMATIC)
    term_scroll.set_min_content_height(90)
    term_holder.set_size_request(-1, 200)
    term_view = Gtk.TextView()
    term_view.set_monospace(True)
    term_view.set_editable(True)
    term_view.set_wrap_mode(Gtk.WrapMode.WORD_CHAR)
    term_view.set_left_margin(10)
    term_view.set_right_margin(10)
    term_view.set_top_margin(8)
    term_view.set_bottom_margin(8)
    term_view.set_name("termview")
    term_buf = term_view.get_buffer()
    term_scroll.add(term_view)
    term_holder.pack_start(term_scroll, True, True, 0)

    # ▶ çalıştır + temizle
    term_bar = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
    term_bar.set_border_width(6)
    btn_term_run = Gtk.Button(label="Çalıştır")
    btn_term_run.set_tooltip_text("Yazdığınız komutu çalıştır (Enter)")
    btn_term_clear = Gtk.Button(label="Temizle")
    btn_term_clear.set_tooltip_text("Terminal çıktısını temizle")
    term_bar.pack_start(btn_term_run, False, False, 0)
    term_bar.pack_start(btn_term_clear, False, False, 0)
    term_holder.pack_start(term_bar, False, False, 0)

    # Yerleşim: günlük (esner) + terminal (sabit yükseklik, altta).
    # DİKKAT (2026-11-15 canlı test): Gtk.Paned ile yükseklik ayarı Openbox
    # altında güvenilir değildi — terminal açılınca içerik pencerenin dışına
    # taşıyordu. Sabit yükseklikli alt panel hem öngörülebilir hem de
    # kullanımı engellemiyor: günlük alanı esner, terminal 300 px yer kaplar.
    outer.pack_start(scroll, True, True, 0)
    outer.pack_start(term_holder, False, False, 0)

    term_state = {"visible": False, "cwd": os.path.expanduser("~"),
                  "hist": [], "hi": -1, "prompt": "$ "}

    def term_write(text):
        def _do():
            term_buf.insert(term_buf.get_end_iter(), text)
            m = term_buf.create_mark(None, term_buf.get_end_iter(), False)
            term_view.scroll_mark_onscreen(m)
        GLib.idle_add(_do)

    def term_show(show=True):
        # DİKKAT: set_no_show_all(False) ÖNCE çağrılmalı; aksi hâlde show_all()
        # hiçbir şey göstermez (canlı testte panel açılmıyordu).
        term_state["visible"] = show
        if show:
            term_holder.set_no_show_all(False)
            term_holder.show_all()
            term_view.grab_focus()
        else:
            term_holder.set_no_show_all(True)
            term_holder.hide()
        return False

    def toggle_terminal(*_a):
        show = not term_state["visible"]
        term_show(show)
        try:
            btn_console.set_label("Konsol Kapat" if show else "Konsol Aç")
        except NameError:
            pass
        return False

    def term_prompt():
        term_write(f"\n{term_state['cwd']} {term_state['prompt']}")

    def term_run(*_a):
        cmd = term_buf.get_text(term_buf.get_start_iter(),
                                term_buf.get_end_iter(), False).split("\n")[-1]
        cmd = cmd.split(term_state["prompt"], 1)[-1].strip()
        if not cmd:
            return False
        term_state["hist"].append(cmd)
        term_state["hi"] = len(term_state["hist"])
        if cmd in ("clear", "cls"):
            term_buf.set_text("")
            term_prompt()
            return False
        if cmd.startswith("cd "):
            target = os.path.expanduser(cmd[3:].strip())
            nxt = os.path.normpath(os.path.join(term_state["cwd"], target))
            term_state["cwd"] = nxt if os.path.isdir(nxt) else term_state["cwd"]
            term_prompt()
            return False

        def _worker():
            term_write("\n")
            try:
                proc = subprocess.Popen(cmd, shell=True, cwd=term_state["cwd"],
                                        stdout=subprocess.PIPE,
                                        stderr=subprocess.STDOUT,
                                        text=True, bufsize=1)
                for line in proc.stdout:
                    term_write(line)
                proc.wait()
            except Exception as exc:                      # noqa: BLE001
                term_write(f"[hata] {exc}\n")
            term_prompt()

        threading.Thread(target=_worker, daemon=True).start()
        return False

    def _on_term_key(_w, ev):
        if ev.keyval in (Gdk.KEY_Return, Gdk.KEY_KP_Enter):
            term_run()
            return True
        if ev.keyval == Gdk.KEY_Up and term_state["hist"]:
            term_state["hi"] = max(0, term_state["hi"] - 1)
            cmd = term_state["hist"][term_state["hi"]]
            term_buf.set_text(term_buf.get_text(
                term_buf.get_start_iter(), term_buf.get_end_iter(), False
            ).rsplit("\n", 1)[0] + "\n" + term_state["cwd"] + " "
                + term_state["prompt"] + cmd)
            return True
        if ev.keyval == Gdk.KEY_Down and term_state["hist"]:
            term_state["hi"] = min(len(term_state["hist"]) - 1, term_state["hi"] + 1)
            cmd = term_state["hist"][term_state["hi"]]
            term_buf.set_text(term_buf.get_text(
                term_buf.get_start_iter(), term_buf.get_end_iter(), False
            ).rsplit("\n", 1)[0] + "\n" + term_state["cwd"] + " "
                + term_state["prompt"] + cmd)
            return True
        return False

    term_view.connect("key-press-event", _on_term_key)
    btn_term_run.connect("clicked", term_run)
    btn_term_clear.connect("clicked", lambda *_: term_buf.set_text(""))
    btn_term_hide.connect("clicked", lambda *_: term_show(False))
    # Başlık çubuğundan terminal bölmesini sürükle
    term_head.add_events(Gdk.EventMask.BUTTON_PRESS_MASK)
    term_head.connect("button-press-event", _start_drag)

    def _term_init():
        term_write("MacNix Terminal — komut yazıp Enter'a basın "
                   "(sudo şifresiz; 'macnix-doctor' tanılama).\n")
        term_prompt()
        return False
    GLib.idle_add(_term_init)


    # Düğmeler
    btnbox = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
    btnbox.set_border_width(14)

    btn_install = Gtk.Button(label="macOS kurulumunu hazırla")
    btn_boot = Gtk.Button(label="macOS'u başlat")
    btn_doctor = Gtk.Button(label="Tanılama")
    btn_console = Gtk.Button(label="Konsol Aç")
    btn_console.set_tooltip_text("Terminal panelini aç/kapat (Ctrl+T)")

    btnbox.pack_end(btn_install, False, False, 0)
    btnbox.pack_start(btn_console, False, False, 0)
    btnbox.pack_start(btn_doctor, False, False, 0)
    btnbox.pack_start(btn_boot, False, False, 0)
    outer.pack_start(btnbox, False, False, 0)

    def log(msg: str):
        def _do():
            end = logbuf.get_end_iter()
            logbuf.insert(end, msg + "\n")
            mark = logbuf.create_mark(None, logbuf.get_end_iter(), False)
            logview.scroll_mark_onscreen(mark)
        GLib.idle_add(_do)

    def mark(no, symbol, color):
        def _do():
            icon, label = rows[no]
            icon.set_markup(f"<span foreground='{color}' weight='bold'>{symbol}</span>")
        GLib.idle_add(_do)

    def set_progress(fraction):
        GLib.idle_add(lambda: prog.set_fraction(fraction) or False)

    running = {"flag": False}

    def worker():
        running["flag"] = True
        GLib.idle_add(lambda: btn_install.set_sensitive(False))
        total = len(STEPS)
        for idx, (name, no) in enumerate(STEPS, start=1):
            mark(no, "◐", "#0b5")
            log(f"\n▶ {no}. {name}")
            ok_holder = {"ok": False}

            def on_line(msg, no=no):
                if msg.strip():
                    log("   " + msg)

            def on_done(no_, ok, idx=idx):
                ok_holder["ok"] = ok
                mark(no_, "✔" if ok else "✖", "#1a7f37" if ok else "#c00")
                set_progress(idx / total)

            run_step(no, on_line, on_done)
            if not ok_holder["ok"]:
                log(f"\nAdım {no} başarısız oldu. 'Tanılama' ile ayrıntı görebilirsiniz.")
                GLib.idle_add(lambda: btn_install.set_sensitive(True))
                running["flag"] = False
                return
        log("\n✔ Hazırlık tamamlandı. Kurulum ekranı açılıyor…")
        set_progress(1.0)
        GLib.idle_add(lambda: btn_install.set_sensitive(True))
        running["flag"] = False

    def on_install(_b):
        if running["flag"]:
            return
        threading.Thread(target=worker, daemon=True).start()

    def on_boot(_b):
        # DİKKAT (2026-11-15): Eski sürüm yalnızca "macOS başlatılıyor…" yazıp
        # hiçbir çıktı göstermiyordu. QEMU düştüğünde kullanıcı hatayı göremiyordu.
        # Artık macnix-vm'in tüm çıktısı canlı günlüğe akar ve çıkış kodu yazılır.
        btn_boot.set_sensitive(False)
        log("── macOS'u başlat ─────────────────────────────")

        def _worker():
            try:
                proc = subprocess.Popen(
                    SUDO + ["macnix-vm", "start"],
                    stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                    text=True, bufsize=1)
                for line in proc.stdout:
                    log(line.rstrip())
                proc.wait()
                if proc.returncode == 0:
                    log("✔ QEMU başladı. VM penceresi Sanal Makine panelinden izlenebilir.")
                else:
                    log(f"✘ macOS başlatılamadı (çıkış kodu {proc.returncode}).")
                    log("  Ayrıntı: 'Tanılama' düğmesi · günlük: /var/lib/macnix/logs/qemu.log")
            finally:
                GLib.idle_add(lambda: btn_boot.set_sensitive(True))

        threading.Thread(target=_worker, daemon=True).start()

    def on_doctor(_b):
        proc = subprocess.run(SUDO + ["macnix-doctor"], capture_output=True, text=True)
        log(proc.stdout or proc.stderr)
        log(f"(çıkış kodu: {proc.returncode})")

    def on_console(_b):
        toggle_terminal()

    btn_install.connect("clicked", on_install)
    btn_boot.connect("clicked", on_boot)
    btn_doctor.connect("clicked", on_doctor)
    btn_console.connect("clicked", on_console)

    # Başlangıç durumu
    for name, no in STEPS:
        ready = {
            1: st["assets"], 2: st["ovmf"], 3: st["basesystem"],
            4: st["basesystem"], 5: st["disk"], 6: st["opencore"], 7: st["state"] == "installed",
        }.get(no, False)
        if st["state"] == "installed":
            mark(no, "✔", "#1a7f37")
        elif ready:
            mark(no, "✔", "#1a7f37")
        else:
            mark(no, "○", "#888")

    log("MacNix hazır. 'macOS kurulumunu hazırla' düğmesine basın.")
    if st["state"] == "installed":
        log("macOS kurulu görünüyor — doğrudan 'macOS'u başlat' diyebilirsiniz.")

    win.show_all()
    # Terminal paneli varsayılan olarak KAPALI açılır; "Konsol" düğmesi ya da
    # Ctrl+T ile açılır — böylece ekranı kaplayıp kullanımı engellemez.
    term_show(False)

    if os.environ.get("MACNIX_TERM_OPEN") == "1":
        term_show(True)

    Gtk.main()
    return 0


def _apply_theme(Gtk, Gdk):
    """Modern görünüm: koyu, yuvarlak köşeli, mavi vurgulu tema.

    2026-11-15 kullanıcı isteği: arayüz "daha modern" olsun. Ek paket
    gerektirmeyen bir CSS sağlayıcısı kullanılır (GTK3'te yerleşik).
    """
    css = b"""
    window { background: #12151c; color: #e8ecf3; }
    #head { background: linear-gradient(135deg, #1b2333 0%, #12151c 100%);
            border-bottom: 1px solid #263043; }
    label { color: #e8ecf3; }
    list { background: transparent; }
    list row { background: #171c26; border-radius: 10px; margin: 3px 14px;
               border: 1px solid #222b3a; }
    list row:hover { background: #1d2431; border-color: #2f3d54; }
    progressbar trough { background: #1b2230; border-radius: 8px; min-height: 8px; }
    progressbar progress { background: linear-gradient(90deg,#39d0d4,#3b82f6);
                           border-radius: 8px; min-height: 8px; }
    button { background: #1f2836; border: 1px solid #2c3648; border-radius: 9px;
             padding: 7px 14px; color: #dfe6f0; }
    button:hover { background: #273143; border-color: #3f8cff; }
    button:active { background: #2b3850; }
    button:disabled { color: #5c6779; }
    textview, textview text { background: #0e1219; color: #d7e2f0;
                              font-family: "DejaVu Sans Mono", monospace; }
    scrolledwindow { border: 1px solid #222b3a; border-radius: 10px; }
    #termhead { background: #1a2130; border-bottom: 1px solid #263043;
                border-radius: 10px 10px 0 0; }
    #termdots { color: #ff5f57; letter-spacing: 3px; }
    #termview { background: #0b0f16; }
    """
    try:
        prov = Gtk.CssProvider()
        prov.load_from_data(css)
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(), prov,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
    except Exception as exc:                      # noqa: BLE001
        print(f"tema uygulanamadı ({exc}) — varsayılan görünüm", file=sys.stderr)


def _which(cmd):
    from shutil import which
    return which(cmd)


if __name__ == "__main__":
    if "--cli" in sys.argv or not os.environ.get("DISPLAY"):
        sys.exit(cli())
    sys.exit(gui())
