#!/usr/bin/env bash
# ============================================================================
#  MacNix 2.0 — macnix-install-macos
# ============================================================================
#  İlk açılışta macOS'u hazırlar. Adımlar tek tek ve tekrar çalıştırılabilir:
#
#     1. Varlıkları hazırla      (OpenCore + kextler; ISO'dan ya da ağdan)
#     2. Firmware hazırla        (OVMF_CODE / OVMF_VARS)
#     3. macOS imajını indir     (Apple kurtarma servisi)
#     4. DMG → IMG dönüştür      (dmg2img)
#     5. macOS diskini oluştur   (qcow2, varsayılan 64 GB)
#     6. OpenCore EFI üret       (donanıma özel config.plist)
#     7. Kurulum VM'ini başlat   (BaseSystem takılı)
#
#  Kullanım:
#     macnix-install-macos                 # hepsini yap
#     macnix-install-macos --step 3        # sadece 3. adım
#     macnix-install-macos --status
#     macnix-install-macos --skip-download # imaj zaten varsa
#     macnix-install-macos --json          # GUI için makine-okunur çıktı
# ============================================================================
set -Eeuo pipefail

ETC="${MACNIX_ETC:-/etc/macnix}"
VARS="${MACNIX_VAR:-/var/lib/macnix}"
ASSETS="${MACNIX_ASSETS:-$VARS/assets}"
DISK_GB="${MACNIX_DISK_GB:-64}"
STEP=0; STATUS=0; JSON=0; SKIP_DL=0; BACKGROUND=0

C_OK=$'\033[0;32m'; C_WA=$'\033[1;33m'; C_ER=$'\033[0;31m'; C_B=$'\033[1m'; C_R=$'\033[0m'
say()  { [[ "$JSON" == "1" ]] && printf '{"event":"log","msg":"%s"}\n' "${*//\"/}" || printf '%s[macnix]%s %s\n' "$C_B" "$C_R" "$*"; }
ok()   { [[ "$JSON" == "1" ]] && printf '{"event":"ok","msg":"%s"}\n' "${*//\"/}" || printf '%s  [ ok ]%s %s\n' "$C_OK" "$C_R" "$*"; }
warn() { [[ "$JSON" == "1" ]] && printf '{"event":"warn","msg":"%s"}\n' "${*//\"/}" || printf '%s [warn]%s %s\n' "$C_WA" "$C_R" "$*"; }
die()  { [[ "$JSON" == "1" ]] && printf '{"event":"error","msg":"%s"}\n' "${*//\"/}" || printf '%s [fail]%s %s\n' "$C_ER" "$C_R" "$*" >&2; exit 1; }
pct()  { [[ "$JSON" == "1" ]] && printf '{"event":"progress","value":%s,"msg":"%s"}\n' "$1" "${2//\"/}"; }

while [[ $# -gt 0 ]]; do
  case "$1" in
    --step) STEP="$2"; shift 2 ;;
    --status) STATUS=1; shift ;;
    --json) JSON=1; shift ;;
    --skip-download) SKIP_DL=1; shift ;;
    --background) BACKGROUND=1; shift ;;
    --disk-gb) DISK_GB="$2"; shift 2 ;;
    -h|--help) sed -n '2,24p' "$0"; exit 0 ;;
    *) die "bilinmeyen argüman: $1" ;;
  esac
done

[[ $EUID -eq 0 ]] || die "root gerekli (sudo macnix-install-macos)"

mkdir -p "$VARS"/{logs,disks,firmware}

plan_get() {
  python3 - "$ETC/install-plan.json" "$1" "${2:-}" 2>/dev/null <<'PY'
import json, sys
try:
    plan = json.load(open(sys.argv[1]))
except Exception:
    print(sys.argv[3] if len(sys.argv) > 3 else "")
    raise SystemExit
key = sys.argv[2]
val = plan
for part in key.split("."):
    if isinstance(val, dict):
        val = val.get(part, "")
    else:
        val = ""
        break
print(val if val is not None else "")
PY
}

# ── Durum ───────────────────────────────────────────────────────────────────
if (( STATUS )); then
  printf '%-22s %s\n' "varlıklar (OpenCore)" \
    "$([[ -f "$ASSETS/opencore/OC/OpenCore.efi" ]] && echo hazır || echo eksik)"
  printf '%-22s %s\n' "OpenCore diski" \
    "$([[ -f "$VARS/firmware/OpenCore/OpenCore.qcow2" ]] && echo hazır || echo eksik)"
  printf '%-22s %s\n' "OVMF firmware" \
    "$([[ -f "$VARS/firmware/OVMF_CODE.fd" ]] && echo hazır || echo eksik)"
  printf '%-22s %s\n' "BaseSystem.img" \
    "$([[ -f "$VARS/disks/BaseSystem.img" ]] && echo hazır || echo eksik)"
  printf '%-22s %s\n' "macOS diski" \
    "$([[ -f "$VARS/disks/macOS.qcow2" ]] && du -h "$VARS/disks/macOS.qcow2" | cut -f1 || echo eksik)"
  printf '%-22s %s\n' "kurulum durumu" \
    "$(python3 - "$VARS/state.json" <<'PY' 2>/dev/null
import json, os, sys
try:
    print(json.load(open(sys.argv[1])).get("state", "bilinmiyor"))
except Exception:
    print("yeni kurulum")
PY
)"
  exit 0
fi

# ============================================================================
#  1. Varlıklar
# ============================================================================
step_assets() {
  say "1/7  Önyükleme bileşenleri hazırlanıyor"
  pct 5 "Varlıklar denetleniyor"
  if [[ -d "$ASSETS/opencore/OC" && -d "$ASSETS/kexts" ]]; then
    ok "varlıklar mevcut ($(du -sh "$ASSETS" | cut -f1))"
    return 0
  fi
  # ISO içine gömülü kopya var mı?
  if [[ -d /opt/macnix/assets/opencore/OC ]]; then
    cp -a /opt/macnix/assets/. "$ASSETS/" 2>/dev/null || true
    ok "ISO içindeki varlıklar kullanıldı"
    return 0
  fi
  /usr/local/bin/macnix-assets --dest "$ASSETS" || \
    die "Bileşenler indirilemedi. İnternet bağlantısını kontrol edin.
Sonra: sudo macnix-assets"
}

# ============================================================================
#  2. Firmware
# ============================================================================
step_firmware() {
  say "2/7  UEFI firmware (OVMF) hazırlanıyor"
  pct 10 "OVMF kopyalanıyor"
  local code="" vars=""
  for f in /usr/share/OVMF/OVMF_CODE_4M.fd /usr/share/OVMF/OVMF_CODE.fd \
           /usr/share/edk2/ovmf/OVMF_CODE.fd /usr/share/ovmf/OVMF.fd \
           /usr/share/OVMF/OVMF_CODE.secboot.fd; do
    [[ -f "$f" ]] && { code="$f"; break; }
  done
  for f in /usr/share/OVMF/OVMF_VARS_4M.fd /usr/share/OVMF/OVMF_VARS.fd \
           /usr/share/edk2/ovmf/OVMF_VARS.fd; do
    [[ -f "$f" ]] && { vars="$f"; break; }
  done
  [[ -n "$code" ]] || die "OVMF_CODE bulunamadı (apt install ovmf)"
  cp -f "$code" "$VARS/firmware/OVMF_CODE.fd"
  if [[ -n "$vars" ]]; then
    cp -f "$vars" "$VARS/firmware/OVMF_VARS.fd"
  else
    # VARS yoksa boş değişken deposu üret (4 MB)
    dd if=/dev/zero of="$VARS/firmware/OVMF_VARS.fd" bs=1M count=4 status=none
  fi
  rm -f "$VARS/firmware/OVMF_VARS.runtime.fd"
  ok "OVMF: $(basename "$code") / $(basename "${vars:-vars-uretildi}")"
}

# ============================================================================
#  3. macOS imajı
# ============================================================================
step_download() {
  local ver; ver="$(plan_get macos_version ventura)"
  say "3/7  macOS ${ver} kurulum imajı"
  if [[ -f "$VARS/disks/BaseSystem.dmg" ]] && (( SKIP_DL )); then
    ok "BaseSystem.dmg zaten var, atlanıyor"
    return 0
  fi
  if [[ -f "$VARS/disks/BaseSystem.dmg" ]]; then
    local sz; sz=$(stat -c%s "$VARS/disks/BaseSystem.dmg")
    if (( sz > 400000000 )); then
      ok "BaseSystem.dmg mevcut ($((sz/1048576)) MB)"
      return 0
    fi
  fi
  pct 20 "Apple sunucularından indiriliyor (yaklaşık 700 MB)"
  local tmp_log="$VARS/logs/fetch.log"
  if /usr/local/bin/macnix-fetch-macos --os "$ver" --out "$VARS/disks" >"$tmp_log" 2>&1; then
    ok "imaj indirildi ($(du -h "$VARS/disks/BaseSystem.dmg" 2>/dev/null | cut -f1 || echo '?'))"
  else
    tail -20 "$tmp_log" >&2 || true
    die "İndirme başarısız. Ağ bağlantısını kontrol edip tekrar deneyin:
sudo macnix-install-macos --step 3"
  fi
}

# ============================================================================
#  4. DMG → IMG
# ============================================================================
step_convert() {
  say "4/7  Disk imajı dönüştürülüyor"
  if [[ -f "$VARS/disks/BaseSystem.img" ]]; then
    ok "BaseSystem.img mevcut"
    return 0
  fi
  local dmg
  dmg=$(ls "$VARS/disks"/*.dmg 2>/dev/null | head -1 || true)
  [[ -n "$dmg" ]] || die "DMG bulunamadı (önce --step 3)"
  pct 40 "dmg2img çalışıyor"
  if command -v dmg2img >/dev/null; then
    dmg2img "$dmg" "$VARS/disks/BaseSystem.img" >/dev/null 2>&1 || \
      die "dmg2img başarısız — imaj bozuk olabilir (silip yeniden indirin)"
  else
    # yedek yol: 7z
    if command -v 7z >/dev/null; then
      7z x -y -o/tmp/dmgx "$dmg" >/dev/null 2>&1
      local raw; raw=$(find /tmp/dmgx -name '*.hfs' -o -name '*.img' | head -1)
      [[ -n "$raw" ]] && cp "$raw" "$VARS/disks/BaseSystem.img"
    fi
  fi
  [[ -f "$VARS/disks/BaseSystem.img" ]] || die "Dönüştürme başarısız"
  ok "BaseSystem.img: $(du -h "$VARS/disks/BaseSystem.img" | cut -f1)"
}

# ============================================================================
#  5. macOS diski
# ============================================================================
step_disk() {
  say "5/7  macOS diski (${DISK_GB} GB)"
  if [[ -f "$VARS/disks/macOS.qcow2" ]]; then
    ok "disk mevcut ($(du -h "$VARS/disks/macOS.qcow2" | cut -f1))"
    return 0
  fi
  pct 55 "qcow2 oluşturuluyor"
  qemu-img create -f qcow2 -o preallocation=metadata,cluster_size=1M \
    "$VARS/disks/macOS.qcow2" "${DISK_GB}G" >/dev/null
  ok "macOS.qcow2 oluşturuldu"
}

# ============================================================================
#  6. OpenCore
# ============================================================================
step_opencore() {
  say "6/7  OpenCore EFI üretiliyor (donanıma özel)"
  pct 70 "config.plist yazılıyor"
  /usr/local/bin/macnix-oc --build 2>&1 | sed 's/^/    /' || die "OpenCore üretilemedi"
  ok "OpenCore hazır"
}

# ============================================================================
#  7. Kurulum VM
# ============================================================================
step_boot_install() {
  say "7/7  macOS kurulumu başlatılıyor"
  pct 90 "VM açılıyor"
  if [[ -f "$VARS/state.json" ]] && grep -q '"state": "installed"' "$VARS/state.json" 2>/dev/null; then
    ok "macOS zaten kurulu — normal başlatma moduna geçiliyor"
    return 0
  fi
  python3 - "$VARS/state.json" <<'PY'
import json, sys
state = {"state": "install", "started_at": __import__("datetime").datetime.now().isoformat()}
json.dump(state, open(sys.argv[1], "w"), indent=2)
PY
  pct 100 "Kurulum ekranı açılıyor"

  if (( BACKGROUND )); then
    nohup /usr/local/bin/macnix-vm install >>"$VARS/logs/install.log" 2>&1 &
    ok "kurulum VM'i arka planda başlatıldı"
  else
    say "Kurulum VM'i başlıyor — macOS Kurtarma ekranı açılacak."
    say "Adımlar: Disk İzlencesi → 'Macintosh HD' APFS oluştur → macOS Yükle"
    exec /usr/local/bin/macnix-vm install
  fi
}

# ============================================================================
#  Çalıştır
# ============================================================================
if (( STEP > 0 )); then
  case "$STEP" in
    1) step_assets ;;
    2) step_firmware ;;
    3) step_download ;;
    4) step_convert ;;
    5) step_disk ;;
    6) step_opencore ;;
    7) step_boot_install ;;
    *) die "geçersiz adım: $STEP (1-7)" ;;
  esac
  exit 0
fi

step_assets
step_firmware
step_download
step_convert
step_disk
step_opencore
step_boot_install
