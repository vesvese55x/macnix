/* === GLOBAL === */
QWidget {
    background-color: #000000;
    color: #FFFFFF;
    font-family: "Inter", "Plus Jakarta Sans", "Segoe UI", sans-serif;
    font-size: 15px;
}

/* === MAIN WINDOW (borderless feel) === */
#mainApp { background-color: #000000; }
#sidebarApp { background-color: #0B0C10; border: none; }
#viewpane { background-color: #000000; }

/* === BUTTONS (Apple-style rounded blue) === */
QPushButton {
    background-color: #0A84FF;
    color: #FFFFFF;
    border: none;
    border-radius: 12px;
    padding: 12px 32px;
    font-size: 15px;
    font-weight: 600;
    min-height: 20px;
}
QPushButton:hover { background-color: #409CFF; }
QPushButton:pressed { background-color: #0071E3; }
QPushButton:disabled { background-color: #3A3A3C; color: #636366; }

/* Secondary buttons */
QPushButton#back, QPushButton[flat="true"] {
    background-color: transparent;
    color: #0A84FF;
    border: none;
}
QPushButton#back:hover { color: #409CFF; }

/* === INPUT FIELDS === */
QLineEdit, QComboBox, QSpinBox {
    background-color: #2C2C2E;
    color: #FFFFFF;
    border: 1px solid #3A3A3C;
    border-radius: 8px;
    padding: 10px 14px;
    font-size: 15px;
    selection-background-color: #0A84FF;
}
QLineEdit:focus, QComboBox:focus {
    border: 2px solid #0A84FF;
}

/* === LABELS === */
QLabel { background: transparent; color: #FFFFFF; }
QLabel[description="true"] { color: #8E8E93; }

/* === LISTS === */
/* NOT (2026-11-14): "QListView, QTreeView" seçicisi Calamares'in yan menüsünü
 * de (ProgressTreeView → #sidebarApp) boyuyordu. Yan menüye kutu/çerçeve
 * çizdiriyor, menü öğelerini görünmez yapıyordu (yerel 3.3.14 ekran
 * görüntüsünde birebir: boş siyah dikdörtgen). Artık yalnızca İÇERİK
 * listeleri stilleniyor; yan menü tamamen branding.desc'teki
 * sidebarBackground/sidebarText renklerine bırakıldı. */
#viewpane QListView, #viewpane QTreeView {
    background-color: #1C1C1E;
    border: 1px solid #2C2C2E;
    border-radius: 10px;
    padding: 4px;
    outline: none;
}
#viewpane QListView::item {
    padding: 12px 16px;
    border-radius: 8px;
    color: #FFFFFF;
}
#viewpane QListView::item:selected {
    background-color: #0A84FF;
}
#viewpane QListView::item:hover:!selected {
    background-color: #2C2C2E;
}

/* === PROGRESS BAR === */
QProgressBar {
    background-color: #3A3A3C;
    border: none;
    border-radius: 4px;
    height: 8px;
    text-align: center;
    color: transparent;
}
QProgressBar::chunk {
    background-color: #0A84FF;
    border-radius: 4px;
}

/* === SCROLL BARS (thin, subtle) === */
QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 4px 2px;
}
QScrollBar::handle:vertical {
    background: #3A3A3C;
    border-radius: 4px;
    min-height: 30px;
}
QScrollBar::handle:vertical:hover { background: #636366; }
QScrollBar::add-line, QScrollBar::sub-line { height: 0; }

/* === CHECKBOX & RADIO === */
/* Onay kutusu: yalnızca metin rengi + aralık. Göstergeyi (indicator)
 * kendimiz çizmeye çalıştığımızda kutu okunmaz hâle geldi (yerel test);
 * kabul çerçevesi (#acceptFrame) Calamares tarafından kırmızı/yeşil
 * çerçeveyle işaretleniyor, ona dokunmuyoruz. */
QCheckBox, QRadioButton { color: #FFFFFF; spacing: 10px; padding: 6px; }
/* Gösterge (kutu) görünür olmalı: global "QWidget { background:#000 }" kuralı
 * kutuyu da siyaha boyuyordu; kullanıcı hiçbir şey görmüyordu (yerel test). */
QCheckBox::indicator, QRadioButton::indicator {
    width: 20px; height: 20px;
    border: 2px solid #8E8E93;
    border-radius: 5px;
    background-color: #1C1C1E;
}
QCheckBox::indicator:checked, QRadioButton::indicator:checked {
    background-color: #0A84FF;
    border-color: #0A84FF;
}
QScrollArea, QScrollArea > QWidget > QWidget { background: transparent; }
QLabel#mainText, QLabel#distroLabel { color: #E8E8ED; }
