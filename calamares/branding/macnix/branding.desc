# MacNix 2.0 — Calamares marka tanımı
---
componentName: macnix

strings:
    productName:         "MacNix"
    shortProductName:    "MacNix"
    version:             2.0
    shortVersion:        "2.0"
    versionedName:       "MacNix 2.0"
    shortVersionedName:  "MacNix 2.0"
    bootloaderEntryName: "MacNix"
    # "Gelişmiş macOS Sanallaştırma Distrosu" tanımı arayüzde (welcome /
    # notesqml / slaytlar / finished) gösterilir; Calamares'in ürün adı
    # alanı kısa tutuluyor ki pencere başlığı taşmasın.
    productUrl:          "https://belgeselsemo.com.tr"
    supportUrl:          "https://github.com/vesvese55x/macnix/issues"
    knownIssuesUrl:      "https://github.com/vesvese55x/macnix/issues"
    releaseNotesUrl:     "https://github.com/vesvese55x/macnix/releases"

images:
    productLogo:         "macnix_logo.png"
    productIcon:         "macnix_logo.png"
    productWelcome:      "macnix_logo.png"

slideshow:               "show.qml"
slideshowAPI:            2

# Pencere: tam ekran yerine sabit boyut — küçük ekranlarda taşma yapmaz
windowExpanding:         normal
windowSize:              1000px,700px
windowPlacement:         center

# NOT: QML yan menü/alt menü DENENDİ ve canlı Calamares 3.3.14 çalıştırmasında
# yan menü paneli kırpıldı (metinler sol kenardan taştı). Yerleşik (C++) menü
# + stylesheet.qss karanlık teması güvenilir sonuç veriyor → varsayılan menüler.
# (calamares-sidebar.qml / calamares-navigation.qml repoda duruyor.)

style:
    SidebarBackground:        "#0B0C10"
    SidebarText:              "#8E8E93"
    # NOT: "SidebarTextSelect" ve "SidebarTextHighlight" Calamares 3.3'te
    # geçerli style anahtarı DEĞİL (3.3.14 canlı çalıştırmada uyarı verdi:
    # "Unknown branding *style* entry"). Kaldırıldı — seçili adımın vurgusu
    # calamares-sidebar.qml içinde doğrudan renklendiriliyor.
    SidebarBackgroundCurrent: "#1C1C1E"
