# MacNix 2.0 — Calamares marka tanımı
---
componentName: macnix

strings:
    productName:         "MacNix"
    shortProductName:    "MacNix"
    version:             2.0
    shortVersion:        "2.0"
    versionedName:       "MacNix 2.0 — Gelişmiş macOS Sanallaştırma Distrosu"
    shortVersionedName:  "MacNix 2.0"
    bootloaderEntryName: "MacNix"
    # "Gelişmiş macOS Sanallaştırma Distrosu" tanımı arayüzde (welcome /
    # notesqml / slaytlar / finished) gösterilir; Calamares'in ürün adı
    # alanı kısa tutuluyor ki pencere başlığı taşmasın.
    productUrl:          "https://belgeselsemo.com.tr"
    supportUrl:          "https://github.com/vesvese55x/macnix/issues"
    knownIssuesUrl:      "https://github.com/vesvese55x/macnix/issues"
    releaseNotesUrl:     "https://github.com/vesvese55x/macnix/releases"

    # ── ZORUNLU KREDİ ──────────────────────────────────────────────────────
    # Calamares bu metni HER pencerede (karşılama, bölümleme, kurulum,
    # bitiş) pencere altbilgisi olarak basar (Branding::setGlobals →
    # "isotypes"/"strings" → CalamaresWindow alt bilgi satırı).
    # NOT: Calamares 3.2'de özel altbilgi anahtarı yok; bu yüzden tanım
    # productName/versionedName içine de işlendi.
    bootloaderEntryName: "MacNix"

# Zorunlu kredi (birebir istenen metin) — slaytlarda, notlar ekranında ve
# altbilgide görünür. Türkçe karakterler olduğu gibi korunur.
creditLine: "MacNix, Gelişmiş macOS Sanallaştırma Distrosu olup, BELGESELSEMO tarafından ARENA.AI sayesinde https://github.com/local-over/macnix orijinal Github reposundan fork edilerek geliştirilmiştir. — http://belgeselsemo.com.tr/"

images:
    productLogo:         "macnix_logo.png"
    productIcon:         "macnix_logo.png"
    productWelcome:      "macnix_logo.png"

slideshow:               "show.qml"
slideshowAPI:            2

# Pencere: tam ekran yerine sabit boyut — küçük ekranlarda taşma yapmaz
windowExpanding:         normal
windowSize:              1000px,700px
windowPlacement:         center

# NOT: QML yan menü/alt menü DENENDİ ve canlı Calamares 3.3.14 çalıştırmasında
# yan menü paneli kırpıldı (metinler sol kenardan taştı). Yerleşik (C++) menü
# + stylesheet.qss karanlık teması güvenilir sonuç veriyor → varsayılan menüler.
# (calamares-sidebar.qml / calamares-navigation.qml repoda duruyor.)

style:
    # DİKKAT: anahtarlar KÜÇÜK HARFLE yazılmalı. Calamares 3.2.61 kaynağı
    # (Branding::s_styleEntryStrings / CalamaresWindow.cpp) renkleri
    # "sidebarBackground", "sidebarText", "sidebarTextSelect",
    # "sidebarTextHighlight" adlarıyla arar. "SidebarBackground" yazıldığında
    # değer BULUNAMIYOR, palet rengi boş kalıyor ve yan menü metni koyu
    # zeminde SİYAH oluyordu (canlı VM ekran görüntüsünde birebir görüldü).
    sidebarBackground:        "#0B0C10"
    sidebarText:              "#B9B9C2"
    sidebarTextSelect:        "#FFFFFF"
    sidebarTextHighlight:     "#1C1C1E"
